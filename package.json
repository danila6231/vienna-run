{
  "name": "vienna-run",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate.ts",
    "build:offline": "tsc --noEmit && vite build --mode offline",
    "e2e": "playwright test",
    "soak": "SOAK_ROUNDS=200 playwright test tests/e2e/soak.spec.ts",
    "package:offline": "npm run build:offline && cp kiosk/launch-offline.bat kiosk/OFFLINE-README.txt dist-offline/ && cd dist-offline && zip -qr ../vienna-run-offline.zip ."
  },
  "dependencies": {
    "@fontsource/albert-sans": "5.3.0",
    "@fontsource/federo": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
